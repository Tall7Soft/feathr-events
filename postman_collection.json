              "host": ["{{baseUrl}}"],
              "path": ["health", "queue"]
            },
            "description": "Inspect the queue/worker counters. `processed` should increment within ~1 second of step 1 (batch_timeout = 1s by default)."
          }
        },
        {
          "name": "3. Read the event back by user_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?user_id=demo-user",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                {"key": "user_id", "value": "demo-user"}
              ]
            },
            "description": "List all events for `demo-user`. The event from step 1 should appear here."
          }
        },
        {
          "name": "4. Find it via full-text search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/search?q=postman-walkthrough",
              "host": ["{{baseUrl}}"],
              "path": ["events", "search"],
              "query": [
                {"key": "q", "value": "postman-walkthrough"}
              ]
            },
            "description": "Find the event by the campaign tag in metadata. Round-trip ingest → worker → ES → search."
          }
        },
        {
          "name": "5. See it counted in realtime stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/stats/realtime?window_seconds=300",
              "host": ["{{baseUrl}}"],
              "path": ["events", "stats", "realtime"],
              "query": [
                {"key": "window_seconds", "value": "300"}
              ]
            },
            "description": "Recent 5-minute summary. The event from step 1 contributes to the `click` count."
          }
        },
        {
          "name": "6. Cache hit on the same window",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/stats/realtime?window_seconds=300",
              "host": ["{{baseUrl}}"],
              "path": ["events", "stats", "realtime"],
              "query": [
                {"key": "window_seconds", "value": "300"}
              ]
            },
            "description": "Repeat the same request within the TTL window (10s). `cache_hit` should now be `true` and `generated_at` should match the previous response exactly."
          }
