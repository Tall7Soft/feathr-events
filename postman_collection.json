                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('lastEventId', pm.response.json().event_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"click\",\n  \"user_id\": \"demo-user\",\n  \"source_url\": \"https://feathr.co/postman-demo\",\n  \"timestamp\": \"{{demoTimestamp}}\",\n  \"metadata\": {\n    \"campaign\": \"postman-walkthrough\",\n    \"label\": \"demo-event\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "description": "Posts a click event with the current timestamp. Captures the `event_id` so step 2 can read it back."
          }
        },
        {
          "name": "2. Watch the worker process it",
          "request": {
            "method": "GET",
